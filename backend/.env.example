# Copy this file to .env and fill in your own values

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/resume_matcher

# OR MongoDB Atlas (cloud) - example format:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resume_matcher

OPENAI_API_KEY=your_openai_api_key_here

PORT=5000
